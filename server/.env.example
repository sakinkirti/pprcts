PORT=5001
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only. Never prefix this with VITE_ or expose it to a browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace_with_32_byte_base64_key
# Used to HMAC rate-limit identities before they are stored. Use a separate random value.
RATE_LIMIT_HASH_SALT=replace_with_at_least_32_random_characters
ALLOWED_ORIGINS=http://localhost:5173
ENABLE_SCHEDULER=false
# Optional application-wide fallback. Users can save personal keys in Settings;
# a key is required for OpenAlex content downloads but not casual catalog search.
OPENALEX_API_KEY=
# Keep false unless your rights policy permits processing content without a clear reusable license.
OPENALEX_ALLOW_UNLICENSED_FULLTEXT=false
# Must support strict Structured Outputs.
OPENAI_SUMMARY_MODEL=gpt-4o
